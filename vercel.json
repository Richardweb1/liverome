{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "/liverome/frontend/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/liverome/frontend/app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/liverome/frontend/index.html"
    }
  ]
}
